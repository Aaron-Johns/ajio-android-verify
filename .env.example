# Copy this file to `.env` (same folder) and fill in the values. `.env` is gitignored: never commit it.
# Where the values come from: README.md, section 3.

# Required
AJIO_THEME_BEARER=
GEMINI_API_KEY=

# Only if the feed or cohort code asks for them
# FP_SIGNATURE_SECRET=
# AJIO_ACCOUNT_TOKEN=

# Optional tuning. Each has a built-in default, so leave these commented out unless you have a reason.
# AJIO_DEVICE_ID=
# AJIO_PINCODE=
# AJIO_LATITUDE=
# AJIO_LONGITUDE=
# AJIO_APPLICATION_ID=
# AJIO_USER_GROUPS=
# AJIO_EXPERIMENTAL_FEATURES=
# AJIO_FP_SDK_VERSION=
# GEMMA_CALLS_PER_MINUTE=
# GEMMA_PACER_SHARED=
